# API
PORT=3000
LOG_LEVEL=info
NODE_ENV=development

# Base URL the Temporal activities use to call the mock supplier endpoints.
# Local (non-Docker) dev: http://localhost:3000 · Docker Compose: http://api:3000
SUPPLIER_BASE_URL=http://localhost:3000

# Temporal (Docker Compose: temporal:7233)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hotel-offers

# Redis (Docker Compose: redis://redis:6379)
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300

# Failure simulation (initial state of the in-memory toggle)
SUPPLIER_A_DOWN=false
SUPPLIER_B_DOWN=false
